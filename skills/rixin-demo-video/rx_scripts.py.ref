"""Script JSON + narration lines for the 锐新科技 batch (DMA, 51, sensors). FOC lives in the same shape (see remotion/src/scripts/foc.json).
Usage: python -I tools/rx_scripts.py   (run from fcc-video). Writes remotion/src/scripts/<id>.json and remotion/src/<id>_lines.json."""
import json

T = lambda *a: [{"t": x} if isinstance(x, str) else {"t": x[0], "hl": True} for x in a]
POSE = {'hook': [('surprised', 'ping'), ('think', 'pop')], 'valid': [('check', 'stamp'), ('check', 'pop')],
        'analogy': [('none', 'whoosh'), ('none', 'page'), ('none', 'page')], 'chain': [('think', 'whoosh'), ('think', 'pop'), ('think', 'pop')],
        'impact': [('surprised', 'boom'), ('check', 'pop')], 'timeline': [('check', 'whoosh'), ('check', 'ping')], 'outro': [('wave', 'whoosh'), ('wave', 'pop')]}


def beats(prefix, rows):
    out, cnt, n = [], {}, 0
    for sc, sub, sp in rows:
        n += 1
        i = cnt.get(sc, 0)
        cnt[sc] = i + 1
        if sc in POSE:
            po, sf = POSE[sc][min(i, len(POSE[sc]) - 1)]
        elif sc.startswith('demo'):
            po, sf = (['think', 'check', 'check', 'check'][min(i, 3)], 'whoosh' if i == 0 else 'pop')
        else:
            po, sf = ('point', 'whoosh') if i == 0 else (('check', 'pop') if sub.startswith(('一句话', '八位', '四类')) else ('point', 'tick'))
        out.append((f"{prefix}{n}", sc, sub, sp, po, sf))
    return out


META = lambda title, src: {"brand": "锐新科技", "栏目": "单片机科普", "watermark": "@锐新科技", "source": "信息来源：" + src, "mascot": "rixin", "theme": "paper",
                           "voice": "zh_male_zhengtaikp", "decor": "electronic", "视频标题（发布用）": title}


def write(id_, prefix, rows, scenes, title, src):
    B = beats(prefix, rows)
    js = {"meta": META(title, src), "beats": [{"id": i, "scene": sc, "text": t, "pose": po, "sfx": sf} for i, sc, t, _, po, sf in B], "scenes": scenes}
    open(f'remotion/src/scripts/{id_}.json', 'w', encoding='utf-8', newline='\n').write(json.dumps(js, ensure_ascii=False, indent=1))
    open(f'remotion/src/{id_}_lines.json', 'w', encoding='utf-8', newline='\n').write(json.dumps([{"id": i, "text": (sp or t)} for i, _, t, sp, _, _ in B], ensure_ascii=False, indent=1))
    print(id_, len(B), 'beats')


OUT = lambda b: {"title": T("关注", ("锐新科技",)), "sticker": "锐新科技", "bubble": b}

