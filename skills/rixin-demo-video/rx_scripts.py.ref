    {"hook": {"title": T("串口", ("丢字",)), "badges": ["H", "E", "?", "L", "O", "?"], "chip": "明明发了完整的", "bubble": "谁来搬？"},
     "valid": {"title": T("DMA 是", ("搬运工",)), "icon": "box", "stamp": "DMA", "tag": "直接存储器访问", "bubble": "专职搬数据"},
     "demoA": {"title": T("CPU 搬", ("丢字",)), "kind": "dma", "mode": "cpu", "period": 30, "start": 16, "busy": [[70, 170], [230, 320]]},
